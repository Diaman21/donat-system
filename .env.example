# ============================================================
# Donat System — переменные окружения (шаблон)
# Скопируй в .env (или .env.local для Next.js) и заполни.
# Никогда не коммить реальные значения!
# ============================================================

# ---------- Supabase ----------
# project ref и URL берутся в дашборде Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# ВНИМАНИЕ: service_role обходит RLS. Только для бота на сервере!
SUPABASE_SERVICE_ROLE_KEY=

# Для Next.js (Vercel) — публичные клиентские
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Telegram-бот ----------
# токен получить у @BotFather
TELEGRAM_BOT_TOKEN=
# id чата для уведомлений модератору (опционально)
TELEGRAM_MODERATOR_CHAT_ID=

# ---------- Окружение ----------
NODE_ENV=development
