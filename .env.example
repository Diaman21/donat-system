# ============================================================
# Donat System — переменные окружения (шаблон)
# Скопируй в .env и заполни реальными значениями.
# Никогда не коммить .env с реальными данными!
# ============================================================

# ---------- Neon (Postgres) ----------
# Берётся в дашборде Neon → Connection Details
# Pooler — для бота и веба (основное подключение)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Direct — для запуска миграций Drizzle (без пулера, без &channel_binding)
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ---------- Telegram-бот ----------
# Токен получить у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# ID чата модератора для системных уведомлений (опционально)
TELEGRAM_MODERATOR_CHAT_ID=

# ID группы для статистики (числовой, напр. -5085502420)
TELEGRAM_GROUP_ID=

# ---------- Окружение ----------
NODE_ENV=development
