# ============================================================
# Donat System — переменные окружения (шаблон)
# Скопируй в .env и заполни реальными значениями.
# Никогда не коммить .env с реальными данными!
# ============================================================

# ---------- Neon (Postgres) ----------
# Берётся в дашборде Neon → Connection Details
# Pooler — для бота и веба (основное подключение)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Direct — для запуска миграций Drizzle (без пулера, без &channel_binding)
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ---------- Telegram-бот ----------
# Токен БОЕВОГО бота, получить у @BotFather в Telegram.
# Именно он заведён в Vercel и работает через webhook 24/7.
TELEGRAM_BOT_TOKEN=

# Токен ОТДЕЛЬНОГО тестового бота — только для локального `npm run dev`.
# Зачем: Telegram не даёт одному боту работать и по webhook, и по long polling.
# Запуск боевого токена локально снимет webhook и прод замолчит без ошибок.
# Заводится так же: @BotFather → /newbot → токен сюда.
# В Vercel эту переменную НЕ добавлять.
# ⚠️ База у тестового бота общая с боевой — покупки попадут в реальную статистику.
TELEGRAM_BOT_TOKEN_DEV=

# ID чата модератора для системных уведомлений (опционально)
TELEGRAM_MODERATOR_CHAT_ID=

# ID группы для статистики (числовой, напр. -5085502420)
TELEGRAM_GROUP_ID=

# Секрет вебхука (Vercel) — любая случайная строка. Одинаковая локально и в Vercel.
TELEGRAM_WEBHOOK_SECRET=

# Секрет cron (Vercel) — защищает эндпоинт авто-сводки. Любая случайная строка.
CRON_SECRET=

# ---------- Окружение ----------
NODE_ENV=development
