{
  "name": "donat-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram-бот системы управления закупкой донатов",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:check": "tsx src/db/check.ts",
    "setup-webhook": "tsx src/setup-webhook.ts",
    "restore-drill": "tsx src/db/restore-drill.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "grammy": "^1.46.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^25.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
